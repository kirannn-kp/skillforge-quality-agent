USE_MOCK_SERVICES=true
PORT=3001
HOST=127.0.0.1
MAX_IMAGE_MB=8
# Tools remain synthetic. Speech and conversation are separately opt-in.
ENABLE_AZURE_SPEECH=false
ENABLE_FOUNDRY_CONVERSATION=false
# Requires the conversation deployment above to accept image inputs. No mock fallback.
ENABLE_FOUNDRY_VISION=false
AZURE_SPEECH_RESOURCE_ID=
AZURE_AVATAR_CHARACTER=lisa
AZURE_AVATAR_STYLE=casual-sitting
# For Layla talking head: AZURE_AVATAR_CHARACTER=layla and AZURE_AVATAR_STYLE=
# Existing Azure OpenAI deployment used by the opt-in conversational layer.
AZURE_FOUNDRY_PROJECT_ENDPOINT=
AZURE_FOUNDRY_AGENT_ID=
AZURE_FOUNDRY_MODEL_DEPLOYMENT=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_SPEECH_REGION=
AZURE_SPEECH_ENDPOINT=
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
